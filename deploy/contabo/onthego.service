[Unit]
Description=ONTHEGO control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onthego
Group=onthego
EnvironmentFile=/etc/onthego.env
ExecStart=/usr/local/bin/onthego-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/onthego

[Install]
WantedBy=multi-user.target
